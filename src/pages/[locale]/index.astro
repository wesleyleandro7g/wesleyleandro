---
import Header from '@/components/header.astro'
import Footer from '@/components/footer.astro'
import HeroSection from '@/components/sections/hero-section.astro'
import ImpactSection from '@/components/sections/impact-section.astro'
import SelectedWorkSection from '@/components/sections/selected-work-section.astro'
import CurrentFocusSection from '@/components/sections/current-focus-section.astro'
import AboutSection from '@/components/sections/about-section.astro'
import CapabilitiesSection from '@/components/sections/capabilities-section.astro'
import ExperienceSection from '@/components/sections/experience-section.astro'
import CtaSection from '@/components/sections/cta-section.astro'
import Layout from '@/layouts/site-layout.astro'
import { locales, type Locale } from '@/i18n'
export function getStaticPaths() { return locales.map(locale => ({params: {locale}})) }
const { locale } = Astro.params as { locale: Locale }

---
<Layout locale={locale} page='home'>
<Header locale={locale} />
      <main id="main-content" class='grid-bg min-h-screen bg-background text-foreground selection:bg-muted selection:text-foreground'>
        <div class='mx-auto max-w-6xl px-6 pt-24 pb-12'>
          <HeroSection locale={locale} />
          <ImpactSection locale={locale} />
          <SelectedWorkSection locale={locale} />
          <AboutSection locale={locale} />
          <ExperienceSection locale={locale} />
          <CapabilitiesSection locale={locale} />
          <CurrentFocusSection locale={locale} />
          <CtaSection locale={locale} />
          <Footer locale={locale} />
        </div>
      </main>
</Layout>
