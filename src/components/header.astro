---
import { translate, localePath, type Locale } from '@/i18n'
import ContactMenu from './contact-menu.astro'
import LanguageSelector from './language-selector.astro'
import { cn } from '@/lib/utils'
interface Props { locale: Locale }
const { locale } = Astro.props
const t = translate(locale, 'nav')
const pathname = Astro.url.pathname.replace(/\/$/, '')
const links = [ { href: '/work', label: t('work') }, { href: '/writing', label: t('writing') }, { href: '/#about', label: t('about') } ]
---
<header class="fixed top-0 z-50 w-full border-b border-border/60 bg-background/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href={localePath(locale)} class="text-lg font-semibold tracking-tight text-foreground">WL.</a>
    <nav class="hidden items-center gap-6 sm:flex">
      {links.map(link => <a href={localePath(locale, link.href)} aria-current={pathname === localePath(locale, link.href) ? 'page' : undefined} class={cn('text-sm text-muted-foreground transition-colors hover:text-foreground link-underline', pathname === localePath(locale, link.href) && 'text-foreground')}>{link.label}</a>)}
    </nav>
    <div class="flex items-center gap-3"><LanguageSelector locale={locale} /><ContactMenu locale={locale} /></div>
  </div>
</header>
