---
import Github from '@/components/icons/Github.astro'
import Linkedin from '@/components/icons/Linkedin.astro'
import { ArrowRight, ArrowUpRight } from '@lucide/astro'
import FadeIn from '@/components/fade-in.astro'
import SocialLink from '@/components/social-link.astro'
import { siteConfig, data as getData } from '@/utils/data'
import { translate, localePath, richIntro, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

const t = translate(locale, 'home.hero')
const tRoot = translate(locale)
const { caseStudies } = getData(tRoot)

---
<section class='hero-section py-24'>
    <div class='hero-layout'>
      <FadeIn class='hero-copy'>
        <h1 class='hero-title'>
          {t('title')} <br />
          <span>{t('titleHighlight')}</span>
        </h1>

        <p class='hero-role'><span aria-hidden='true'></span>{t('status')}</p>

        <p class='hero-intro mb-4 max-w-2xl text-base leading-relaxed text-muted-foreground'>
          <span set:html={richIntro(t('intro'))} />
        </p>

        <p class='hero-stack mb-8 text-xs text-muted-foreground'>
          {t('tags')}
        </p>

        <div class='hero-actions mb-8 flex flex-wrap gap-3'>
          <a
            href={localePath(locale, '/work')}
            class='inline-flex items-center gap-2 rounded-full bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-colors hover:bg-foreground/90'
          >
            {t('ctaWork')}
            <ArrowRight size={16} />
          </a>
          <a
            href={localePath(locale, '/resume')}
            class='inline-flex items-center gap-2 rounded-full border border-border bg-surface/50 px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-surface'
          >
            {t('ctaExperience')}
          </a>
          <a
            href={`mailto:${siteConfig.contact}`}
            class='inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground'
          >
            {t('ctaContact')}
          </a>
        </div>

        <div class='hero-socials flex flex-wrap gap-3'>
          <p class='hero-signature'>Wesley Leandro</p>
          <SocialLink
            href={siteConfig.links.github}
            label={t('links.github')}
          ><Github size={18} slot="icon" /></SocialLink>
          <SocialLink
            href={siteConfig.links.linkedin}
            label={t('links.linkedin')}
          ><Linkedin size={18} slot="icon" /></SocialLink>
        </div>
      </FadeIn>
      <nav class='hero-projects' aria-label={tRoot('home.work.title')}>
        <div class='project-light' aria-hidden='true'></div>
        {caseStudies.filter(study => study.featured).map(study => (
          <a class='glass-project' href={localePath(locale, `/work/${study.slug}`)}>
            <span class='glass-project-domain'>{study.domain}<ArrowUpRight size={17} aria-hidden='true' /></span>
            <span class='glass-project-name'>{study.company}</span>
            <span class='glass-project-proof'>{study.bullets.b1}</span>
            <span class='glass-project-stack'>{study.stack.slice(0, 3).join(' / ')}</span>
          </a>
        ))}
      </nav>
    </div>
    </section>
