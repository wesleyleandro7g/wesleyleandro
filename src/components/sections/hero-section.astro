---
import Github from '@/components/icons/Github.astro'
import Linkedin from '@/components/icons/Linkedin.astro'
import { FileText, ArrowRight, ArrowUpRight } from '@lucide/astro'
import SocialLink from '@/components/social-link.astro'
import DiscordIcon from '@/components/icons/DiscordIcon.astro'
import TelegramIcon from '@/components/icons/TelegramIcon.astro'
import WhatsAppIcon from '@/components/icons/WhatsAppIcon.astro'
import { siteConfig } from '@/utils/data'
import { translate, localePath, richIntro, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

  const t = translate(locale, 'home.hero')

---
<section class="hero-section">
  <div class="hero-composition">
    <h1 class="hero-title">
      <span class="hero-name">{t('title')}</span>
      <span class="hero-role">{t('titleHighlight')}</span>
    </h1>
    <div class="hero-summary">
      <p class="hero-intro"><span set:html={richIntro(t('intro'))} /></p>
      <div class="hero-actions">
        <a href={localePath(locale, '/work')} class="button-primary">
          {t('ctaWork')} <ArrowUpRight size={18} />
        </a>
        <a href="#experience" class="button-text">
          {t('ctaExperience')} <ArrowRight size={16} />
        </a>
        <a href={'mailto:' + siteConfig.contact} class="hero-contact">{t('ctaContact')}</a>
      </div>
    </div>
  </div>
  <p class="hero-stack">{t('tags')}</p>
  <div class="hero-bottom">
    <p class="availability"><span aria-hidden="true"></span>{t('status')}</p>
    <div class="hero-socials">
      <SocialLink href={siteConfig.links.github} label={t('links.github')}><Github size={16} slot="icon" /></SocialLink>
      <SocialLink href={siteConfig.links.linkedin} label={t('links.linkedin')}><Linkedin size={16} slot="icon" /></SocialLink>
      <SocialLink href={siteConfig.links.discord} label={t('links.discord')}><DiscordIcon class="h-4 w-4" slot="icon" /></SocialLink>
      <SocialLink href={siteConfig.links.telegram} label={t('links.telegram')}><TelegramIcon class="h-4 w-4" slot="icon" /></SocialLink>
      <SocialLink href={siteConfig.links.whatsapp} label={t('links.whatsapp')}><WhatsAppIcon class="h-4 w-4" slot="icon" /></SocialLink>
      <SocialLink href={siteConfig.resume} label={t('links.resume')}><FileText size={16} slot="icon" /></SocialLink>
    </div>
  </div>
</section>
