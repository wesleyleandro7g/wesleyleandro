---
import Github from '@/components/icons/Github.astro'
import Linkedin from '@/components/icons/Linkedin.astro'
import { ArrowRight } from '@lucide/astro'
import FadeIn from '@/components/fade-in.astro'
import SocialLink from '@/components/social-link.astro'
import { siteConfig } from '@/utils/data'
import { translate, localePath, richIntro, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

  const t = translate(locale, 'home.hero')

---
<section class='hero-section py-24'>
      <FadeIn delay={0.1}>
        <div class='mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-surface/50 px-3 py-1 text-xs text-muted-foreground'>
          <span class='relative flex h-2 w-2'>
            <span class='relative inline-flex h-2 w-2 rounded-full bg-emerald-500' />
          </span>
          {t('status')}
        </div>

        <p class='mb-3 text-sm font-medium text-foreground'>Wesley Leandro</p>
        <h1 class='mb-6 text-3xl font-semibold tracking-tight text-foreground sm:text-5xl lg:text-6xl max-w-5xl'>
          {t('title')} <br />
          <span class='text-foreground'>{t('titleHighlight')}</span>
        </h1>

        <p class='mb-4 max-w-2xl text-base leading-relaxed text-muted-foreground'>
          <span set:html={richIntro(t('intro'))} />
        </p>

        <p class='mb-8 font-mono text-xs text-muted-foreground'>
          {t('tags')}
        </p>

        <div class='mb-8 flex flex-wrap gap-3'>
          <a
            href={localePath(locale, '/work')}
            class='inline-flex items-center gap-2 rounded-full bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-colors hover:bg-foreground/90'
          >
            {t('ctaWork')}
            <ArrowRight size={16} />
          </a>
          <a
            href={localePath(locale, '/resume')}
            class='inline-flex items-center gap-2 rounded-full border border-border bg-surface/50 px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-surface'
          >
            {t('ctaExperience')}
          </a>
          <a
            href={`mailto:${siteConfig.contact}`}
            class='inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground'
          >
            {t('ctaContact')}
          </a>
        </div>

        <div class='flex flex-wrap gap-3'>
          <SocialLink
            href={siteConfig.links.github}
            label={t('links.github')}
          ><Github size={18} slot="icon" /></SocialLink>
          <SocialLink
            href={siteConfig.links.linkedin}
            label={t('links.linkedin')}
          ><Linkedin size={18} slot="icon" /></SocialLink>
        </div>
      </FadeIn>
    </section>
