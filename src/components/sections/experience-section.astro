---
import FadeIn from '@/components/fade-in.astro'
import { data as getData } from '@/utils/data'
import { translate, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

  const t = translate(locale, 'home.experience')
  const tRoot = translate(locale)
  const { experience } = getData(tRoot)

---
<section id='experience' class='section-block experience-section'>
      <FadeIn>
        <h2 class='mb-10 text-xl font-medium tracking-tight text-foreground'>
          {t('title')}
        </h2>
        <div class="experience-list">
          {experience.map((job, i) => (
            <article class:list={['experience-entry', { 'experience-current': i === 0 }]}>
              <div class="experience-meta">
                <span class="experience-period">{job.period}</span>
                <h3>{job.company}</h3>
                <p>{job.role}</p>
              </div>
              <p class="experience-description">{job.description}</p>
            </article>
          ))}
        </div>
      </FadeIn>
    </section>
