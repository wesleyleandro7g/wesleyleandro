---
import FadeIn from '@/components/fade-in.astro'
import SectionLabel from '@/components/section-label.astro'
import { data as getData } from '@/utils/data'
import { translate, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

  const t = translate(locale, 'home.experience')
  const tRoot = translate(locale)
  const { experience } = getData(tRoot)

---
<section id='experience' class='py-24'>
      <FadeIn>
        <SectionLabel>{t('label')}</SectionLabel>
        <h2 class='mb-10 text-xl font-medium tracking-tight text-foreground'>
          {t('title')}
        </h2>
        <div class='relative ml-3 space-y-12 border-l border-border'>
          {experience.map((job, i) => (
            <FadeIn delay={0.05 + i * 0.05}>
              <div class='relative pl-8'>
                <span class='absolute -left-1.25 top-2 h-2.5 w-2.5 rounded-full bg-muted-foreground ring-4 ring-background' />
                <div class='mb-2 flex flex-col sm:flex-row sm:items-center sm:justify-between'>
                  <h3 class='text-base font-medium text-foreground'>
                    {job.company}
                  </h3>
                  <span class='font-mono text-xs text-muted-foreground'>
                    {job.period}
                  </span>
                </div>
                <p class='mb-2 text-sm text-muted-foreground'>{job.role}</p>
                <p class='max-w-2xl text-sm leading-relaxed text-muted-foreground'>
                  {job.description}
                </p>
              </div>
            </FadeIn>
          ))}
        </div>
      </FadeIn>
    </section>
