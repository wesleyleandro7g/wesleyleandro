---
import FadeIn from '@/components/fade-in.astro'
import { translate, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

  const t = translate(locale, 'home.about')

---
<section id='about' class='section-block about-section'>
      <FadeIn class="about-grid">
        <h2 class='about-title'>
          {t('title')}
        </h2>
        <div class='about-copy space-y-5 text-base text-muted-foreground'>
          <p>{t('paragraphs.p1')}</p>
          <p>{t('paragraphs.p2')}</p>
          <p>{t('paragraphs.p3')}</p>
          <p>{t('paragraphs.p4')}</p>
          <dl class='space-y-4 border-t border-border pt-6 text-sm'>
            <div>
              <dt class='mb-1 font-medium text-foreground'>{t('educationLabel')}</dt>
              <dd>{t('education')} <span class='whitespace-nowrap'>· {t('educationPeriod')}</span></dd>
            </div>
            <div>
              <dt class='mb-1 font-medium text-foreground'>{t('languagesLabel')}</dt>
              <dd>{t('languages')}</dd>
            </div>
          </dl>
          <p class='pt-2 text-sm text-foreground'>
            {t('closing')}
          </p>
        </div>
      </FadeIn>
    </section>
