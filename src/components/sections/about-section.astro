---
import FadeIn from '@/components/fade-in.astro'
import SectionLabel from '@/components/section-label.astro'
import { translate, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

  const t = translate(locale, 'home.about')

---
<section id='about' class='py-24'>
      <FadeIn>
        <SectionLabel>{t('label')}</SectionLabel>
        <h2 class='mb-8 text-xl font-medium tracking-tight text-foreground'>
          {t('title')}
        </h2>
        <div class='max-w-2xl space-y-4 text-base leading-relaxed text-muted-foreground'>
          <p>{t('paragraphs.p1')}</p>
          <p>{t('paragraphs.p2')}</p>
          <p>{t('paragraphs.p3')}</p>
          <p>{t('paragraphs.p4')}</p>
          <dl class='space-y-4 border-t border-border pt-6 text-sm'>
            <div>
              <dt class='mb-1 font-medium text-foreground'>{t('educationLabel')}</dt>
              <dd>{t('education')} <span class='whitespace-nowrap'>· {t('educationPeriod')}</span></dd>
            </div>
            <div>
              <dt class='mb-1 font-medium text-foreground'>{t('languagesLabel')}</dt>
              <dd>{t('languages')}</dd>
            </div>
          </dl>
          <p class='pt-2 text-sm text-foreground'>
            {t('closing')}
          </p>
        </div>
      </FadeIn>
    </section>
