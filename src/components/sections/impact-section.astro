---
import FadeIn from '@/components/fade-in.astro'
import { data as getData } from '@/utils/data'
import { translate, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

  const t = translate(locale, 'home.impact')
  const tRoot = translate(locale)
  const { impact } = getData(tRoot)

---
<section id='impact' class='impact-section'>
      <FadeIn>
        <h2 class='impact-heading'>
          {t('title')}
        </h2>
        <div class='impact-grid'>
          {impact.map((item, i) => (
            <FadeIn delay={0.1 + i * 0.05}>
              <div class='impact-item'>
                <span class='impact-value'>
                  {item.value}
                </span>
                <span class='text-sm font-medium text-foreground'>
                  {item.label}
                </span>
                <span class='text-xs leading-relaxed text-muted-foreground'>
                  {item.context}
                </span>
              </div>
            </FadeIn>
          ))}
        </div>
      </FadeIn>
    </section>
