---
import FadeIn from '@/components/fade-in.astro'
import { data as getData } from '@/utils/data'
import { translate, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

  const t = translate(locale, 'home.impact')
  const tRoot = translate(locale)
  const { impact } = getData(tRoot)

---
<section id='impact' class='impact-section py-24'>
      <FadeIn>
        <h2 class='mb-10 text-xl font-medium tracking-tight text-foreground'>
          {t('title')}
        </h2>
        <dl class='impact-grid'>
          {impact.map((item) => (
              <div class='impact-item'>
                <dt class='text-sm font-medium text-foreground'>
                  {item.label}
                </dt>
                <dd class='impact-value'>
                  {item.value}
                </dd>
                <dd class='impact-context text-xs text-muted-foreground'>
                  {item.context}
                </dd>
              </div>
          ))}
        </dl>
      </FadeIn>
    </section>
