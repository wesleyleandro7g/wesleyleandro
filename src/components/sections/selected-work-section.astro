---
import { ArrowRight, ArrowUpRight } from '@lucide/astro'
import { data as getData } from '@/utils/data'
import { translate, localePath, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

  const t = translate(locale, 'home.work')
  const tRoot = translate(locale)
  const { caseStudies } = getData(tRoot)

---
<section id="work" class="section-block selected-work">
  <div class="section-heading">
    <h2>{t('title')}</h2>
    <a href={localePath(locale, '/work')} class="button-text">{t('viewAll')}<ArrowRight size={16} /></a>
  </div>
  <div class="project-list">
    {caseStudies.slice(0, 3).map((study, i) => (
      <a href={localePath(locale, '/work/' + study.slug)} class:list={['project-entry group', { 'project-featured': i === 0 }]}>
        <div class="project-identity">
          <span class="project-domain">{study.domain}</span>
          <h3>{study.company}<ArrowUpRight size={24} /></h3>
          <p class="project-role">{study.role}</p>
          <span class="project-period">{study.period}</span>
        </div>
        <div class="project-detail">
          <p class="project-thesis">{study.thesis}</p>
          <ul class="project-outcomes">
            <li>{study.bullets.b1}</li>
            <li>{study.bullets.b2}</li>
          </ul>
          <div class="project-bottom">
            <div class="project-stack">{study.stack.slice(0, 3).map(tech => <span>{tech}</span>)}</div>
            <span class="project-link">{t('readCaseStudy')}<ArrowRight size={16} /></span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
