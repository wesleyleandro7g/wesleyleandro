---
import FadeIn from '@/components/fade-in.astro'
import { data as getData } from '@/utils/data'
import { translate, localePath, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props

  const t = translate(locale, 'home.focus')
  const tRoot = translate(locale)
  const { focusAreas } = getData(tRoot)

---
<section id='focus' class='focus-section py-24'>
      <FadeIn>
        <h2 class='mb-2 text-xl font-medium tracking-tight text-foreground'>
          {t('title')}
        </h2>
        <p class='mb-10 max-w-xl text-sm text-muted-foreground'>
          {t('intro')}
        </p>

        <div class='focus-list'>
          {focusAreas.map((area, i) => (
            <FadeIn delay={0.05 + i * 0.03}>
              <div class='focus-row'>
                <div class='mb-3 flex items-center gap-2'>
                  <h3 class='text-sm font-medium text-foreground'>
                    {area.title}
                  </h3>
                </div>
                <p class='text-xs leading-relaxed text-muted-foreground'>
                  {area.description}
                </p>
                <div class='mt-5 flex flex-wrap gap-3'>{area.projects.map(slug => <a class='text-xs underline text-muted-foreground hover:text-foreground' href={localePath(locale, `/work/${slug}`)}>{tRoot(`workPage.studies.${slug}.company`)}</a>)}</div>
              </div>
            </FadeIn>
          ))}
        </div>
      </FadeIn>
    </section>
