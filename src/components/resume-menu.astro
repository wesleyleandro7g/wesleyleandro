---
import { translate, localePath, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props
const t = translate(locale)
---
<a href={localePath(locale, '/resume')} class="inline-flex items-center rounded-full border border-border px-5 py-2.5 text-sm font-medium hover:bg-surface">{t('home.hero.ctaExperience')}</a>
