---
import { cn } from '@/lib/utils'
interface Props { href: string; label: string; primary?: boolean; class?: string }
const { href, label, primary = false } = Astro.props
const external = /^https?:/.test(href)
---
<a
      href={href}
      {...(external
        ? { target: '_blank', rel: 'noopener noreferrer' }
        : {})}
      class={cn(
        'social-link flex items-center gap-2 px-0 py-2 text-sm font-medium transition-colors',
        primary
          ? 'text-foreground hover:text-accent'
          : 'text-muted-foreground hover:text-foreground'
      )}
    >
      <slot name="icon" />
      {label}
    </a>
