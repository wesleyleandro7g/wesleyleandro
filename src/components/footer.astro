---

import { translate, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props
const t = translate(locale, 'home.footer')
---
<footer class='border-t border-border/60 py-10 text-center'>
      <a href={'/' + locale} class='mb-4 inline-flex flex-col gap-1 text-sm font-medium'>Wesley Leandro<span class="text-xs text-muted-foreground">Senior Software Engineer</span></a>
      <p class='text-xs text-muted-foreground'>
        &copy; {new Date().getFullYear()} Wesley Leandro. {t('rights')}
      </p>
    </footer>
