  "narrative": {
    "northStar": "Black, glass and white light",
    "overview": "Black, glass and white light presents Wesley Leandro's engineering portfolio with deep dark surfaces, editorial headlines and precise technical detail. The user explicitly requested Resend's glass, white glows and typographic character. The implementation expresses that reference through original CSS and real project links, without copied branding or new raster artwork.\n\nThe shared foundation is neutral black, self-hosted Inter, monochrome controls and translucent navigation. The localized landing pages add self-hosted Libre Caslon Display as an open alternative to the reference's Domaine, illuminated project panes and spacious editorial sections. This serif hierarchy is scoped to the landing; it is not a claim about secondary-page headings. Recruiters and technical leaders encounter readable professional evidence through restrained contrast and deliberate depth.",
    "keyCharacteristics": [
      "Deep black and neutral white, with smoke-glass surfaces.",
      "Editorial landing headlines paired with clear sans-serif reading text.",
      "White light identifies project links and contact surfaces.",
      "Technical metadata uses restrained monospace typography.",
      "Responsive layouts and visible keyboard focus preserve access to the same content."
    ],
    "rules": [
      {
        "name": "The Neutral Light Rule",
        "body": "Use white illumination and neutral smoke for the landing identity; keep chromatic utility tokens out of its decorative palette.",
        "section": "colors"
      },
      {
        "name": "The Scoped Editorial Rule",
        "body": "Keep the serif hierarchy within the implemented landing roles; shared body text and controls remain Inter.",
        "section": "typography"
      },
      {
        "name": "The Useful Glass Rule",
        "body": "Glass and glow are intentional parts of the user-requested identity: anchor them to project evidence, navigation and contact surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared neutral tokens and landing-specific scope when extending this identity.",
      "Do reserve Libre Caslon Display for the implemented landing headline and project-title roles.",
      "Do use glass edges and broad white light to clarify useful interactive surfaces.",
      "Do keep technical metadata compact, readable and distinct from editorial headings.",
      "Do preserve keyboard focus, reduced-motion behavior and localized content when adapting components."
    ],
    "donts": [
      "Don't turn the requested glass and white light into colored decorative gradients.",
      "Don't apply the landing serif selectors indiscriminately to secondary pages.",
      "Don't copy Resend branding or replace real project evidence with decorative fake software.",
      "Don't use movement as the only signal that a project pane is interactive."
    ]
  }
}
